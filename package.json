{
  "name": "akb-billing-backend",
  "homepage": "https://kandukurijagan1.github.io/anudeep/",
  "version": "1.0.0",
  "description": "Backend for AKB billing app with invoice history persistence",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "app": "powershell -WindowStyle Hidden -Command \"Start-Process .\\Launch-AKB-App.bat\"",
    "electron": "electron .",
    "dev:electron": "electron .",
    "package:app": "electron-packager . \"AKB-Billing\" --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite --prune=true --ignore=\"/(dist|tmp|test|\\.git|\\.wwebjs_cache|\\.wwebjs_auth)\"",
    "build:exe": "powershell -ExecutionPolicy Bypass -Command \"& 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' /target:winexe /out:AKB-Billing.exe /win32icon:icon.ico /r:System.Windows.Forms.dll,System.Drawing.dll,System.dll Launcher.cs\"",
    "setup:shortcut": "powershell -ExecutionPolicy Bypass -File .\\create-desktop-shortcut.ps1",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.akb.billing",
    "productName": "Anudeep Khadi Bandar - GST Billing",
    "asar": true,
    "asarUnpack": [
      "node_modules/puppeteer/**/*",
      "node_modules/@puppeteer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist",
      "!tmp",
      "!test",
      "!**/.git",
      "!**/.wwebjs_cache",
      "!**/.wwebjs_auth",
      "!Launcher.cs",
      "!AKB-Billing.exe"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "googleapis": "^182.0.0",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.0.16",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
